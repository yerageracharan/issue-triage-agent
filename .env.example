# Optional: improves GitHub API rate limits and allows access to permitted private repositories.
# Use a fine-grained token with Issues: Read-only for only the repositories you need.
GITHUB_TOKEN=

# Optional local OpenAI-compatible chat-completions endpoint used only by the CLI enrichment feature.
# Example LM Studio: http://localhost:1234/v1
# Example Ollama (OpenAI-compatible API): http://localhost:11434/v1
TRIAGE_LLM_BASE_URL=
TRIAGE_LLM_MODEL=
